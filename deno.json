{
    "imports": {
        "dom/":       "https://cdn.jsdelivr.net/gh/stephband/dom@1.4.10/modules/",
        "fn/":        "https://cdn.jsdelivr.net/gh/stephband/fn@1.7.1/modules/",
        "bolt/":      "https://cdn.jsdelivr.net/gh/stephband/bolt-2@1.0.9/",
        "neuron/":    "https://cdn.jsdelivr.net/gh/stephband/neuron@0.1.5/",
        "midi/":      "https://cdn.jsdelivr.net/gh/stephband/midi@1.2.0/modules/",
        "sequence/":  "https://cdn.jsdelivr.net/gh/soundio/sequence@0.5.11/"
    },

    "tasks": {
        "test":            "deno test --allow-read test.js",
        "train":           "deno run -A deno/train.js",
        "transpose":       "deno run --allow-read=. --allow-write=. sequence/deno/transpose-file.js",
        "worker":          "deno run --allow-read --allow-write --allow-net --allow-env --allow-run deno/make-worker.js modules/render/worker-code.js modules/render/worker.js",
        "test:local":      "deno test --import-map deno.local.json --allow-read test.js",
        "train:local":     "deno run -A --import-map deno.local.json deno/train.js",
        "transpose:local": "deno run --import-map deno.local.json --allow-read=. --allow-write=. sequence/deno/transpose-file.js",
        "worker:local":    "deno run --allow-read --allow-write --allow-net --allow-env --allow-run deno/make-worker.js --config=deno.local.json modules/render/worker-code.js modules/render/worker.js"
    },

    "lock": false
}
